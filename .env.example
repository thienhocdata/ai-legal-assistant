APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Hosted providers are opt-in. Keep "none" for the offline extractive fallback.
LLM_PROVIDER=none
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=800
LLM_MAX_RETRIES=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# OpenRouter demo accepts only :free models or openrouter/free.
# Set LLM_PROVIDER=openrouter to opt in; no credit purchase is required for :free.
# ERNIE requires reasoning. Set LLM_MAX_OUTPUT_TOKENS=8192 when opting in;
# this budget includes reasoning and the answer, and is not a target length.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
